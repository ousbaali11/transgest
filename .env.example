# --- Base de données ---------------------------------------------------------
# Créez un projet sur https://supabase.com (ou https://neon.tech / Railway).
# Supabase fournit DEUX chaînes de connexion — les deux sont nécessaires :
#
# DATABASE_URL = la connexion "Connection pooling" (port 6543, pgbouncer),
#                utilisée par l'application à l'exécution (compatible avec
#                les fonctions serverless de Vercel qui ouvrent beaucoup de
#                connexions courtes). Ajoutez ?pgbouncer=true&connection_limit=1
#                à la fin de l'URL.
# DIRECT_URL   = la connexion directe (port 5432), utilisée uniquement par
#                Prisma Migrate pour appliquer les migrations.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Sessions -----------------------------------------------------------------
# Chaîne aléatoire longue et secrète, différente entre dev et production.
# Générez-en une avec : openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Compte admin initial (utilisé par prisma/seed.ts) ------------------------
ADMIN_EMAIL="admin@transgest.ma"
ADMIN_PASSWORD="admin2026"

# Mettre à "true" pour insérer une organisation de démonstration au seed
SEED_DEMO_DATA="false"

# --- Email (code de connexion propriétaire) ------------------------------
# Sans RESEND_API_KEY, les codes sont journalisés dans la console serveur au
# lieu d'être envoyés (voir src/lib/email.ts). Contrairement au SMS, l'email
# n'a pas de restriction par pays à configurer (pas de permissions
# géographiques, pas d'expéditeur à faire approuver par pays).
#
# 1) Créez un compte sur resend.com (gratuit, 3000 emails/mois)
# 2) Copiez votre clé API (commence par "re_") → RESEND_API_KEY
# 3) Pour l'adresse d'expédition, deux options :
#    - Ne rien renseigner : utilise "onboarding@resend.dev" (fonctionne tout
#      de suite, mais peut atterrir en spam plus souvent)
#    - Vérifier votre propre domaine dans Resend (Domains → Add Domain,
#      ajoutez les enregistrements DNS demandés) puis renseignez une adresse
#      de ce domaine dans RESEND_FROM_EMAIL — plus fiable pour la délivrabilité
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- Paiement (abonnement payant) ------------------------------------------
# Voir la section "Configurer Stripe" et "Configurer PayPal" du README pour
# la marche à suivre complète (création des produits/prix, webhooks).
#
# Stripe :
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal (identifiants de votre app REST, Developer Dashboard) :
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# "live" une fois prêt à accepter de vrais paiements, "sandbox" pour tester
PAYPAL_MODE="sandbox"
